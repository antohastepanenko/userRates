{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://+:8080",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "Jwt": {
    "Issuer": "rates",
    "Audience": "rates.api",
    "SigningKey": "REPLACE_ME_WITH_AT_LEAST_32_CHAR_SECRET_FROM_ENV_VAR",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 30
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60,
    "ApiPermitLimit": 120,
    "ApiWindowSeconds": 60
  },
  "Health": {
    "UserServiceUrl": "http://user-api:8080/health/ready",
    "FinanceServiceUrl": "http://finance-api:8080/health/ready",
    "Timeout": "00:00:02"
  },
  "ReverseProxy": {
    "Routes": {
      "user-logout": {
        "ClusterId": "user-api",
        "Order": -10,
        "Match": {
          "Path": "/api/v1/auth/logout"
        },
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "auth",
        "CorsPolicy": "RatesCors",
        "Transforms": [
          {
            "RequestHeadersCopy": true
          }
        ]
      },
      "user-auth": {
        "ClusterId": "user-api",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        },
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "auth",
        "CorsPolicy": "RatesCors",
        "Transforms": [
          {
            "RequestHeadersCopy": true
          }
        ]
      },
      "user-profile": {
        "ClusterId": "user-api",
        "Match": {
          "Path": "/api/v1/users/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "api",
        "CorsPolicy": "RatesCors",
        "Transforms": [
          {
            "RequestHeadersCopy": true
          }
        ]
      },
      "finance": {
        "ClusterId": "finance-api",
        "Match": {
          "Path": "/api/v1/finance/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "api",
        "CorsPolicy": "RatesCors",
        "Transforms": [
          {
            "RequestHeadersCopy": true
          }
        ]
      }
    },
    "Clusters": {
      "user-api": {
        "Destinations": {
          "primary": {
            "Address": "http://user-api:8080"
          }
        }
      },
      "finance-api": {
        "Destinations": {
          "primary": {
            "Address": "http://finance-api:8080"
          }
        }
      }
    }
  }
}
