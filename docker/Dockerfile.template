# syntax=docker/dockerfile:1.6
# Multi-stage Dockerfile for any Rates service. Each service publishes its own Dockerfile
# at <service>/Dockerfile using the same shape; we keep them identical so the Compose
# file can reference a single build context.

ARG PROJECT_PATH=src/BuildingBlocks/Domain/Rates.BuildingBlocks.Domain.csproj

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
ARG PROJECT_PATH
WORKDIR /src

# Copy the whole solution first so MSBuild can resolve project references.
COPY . .

RUN dotnet restore "${PROJECT_PATH}"
RUN dotnet publish "${PROJECT_PATH}" \
    --no-restore \
    --configuration Release \
    --output /app/publish \
    --framework net8.0

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish ./
ENV ASPNETCORE_URLS=http://+:8080 \
    DOTNET_RUNNING_IN_CONTAINER=true \
    DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=true
EXPOSE 8080
ENTRYPOINT ["dotnet", "/app/Rates.BuildingBlocks.Domain.dll"]